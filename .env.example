# ExpressAI Custom API — örnek ortam değişkenleri
#
# Tüm dil örnekleri aynı env değişken isimlerini kullanır.
# Aşağıdakilerden birini doldurup uygulamaya geçirin.

# Auth tipi (API_KEY_SECRET | BASIC_AUTH | BEARER_TOKEN)
AUTH_TYPE=API_KEY_SECRET

# Referans kodu prefix'i — 3 büyük harf (ExpressAI panelinde belirlediğinizle aynı olmalı)
REFERENCE_PREFIX=ABC

# ---- API_KEY_SECRET ----
EXPRESSAI_API_KEY=replace-with-long-random-string
EXPRESSAI_API_SECRET=replace-with-long-random-string

# ---- BASIC_AUTH ----
EXPRESSAI_USERNAME=
EXPRESSAI_PASSWORD=

# ---- BEARER_TOKEN ----
EXPRESSAI_BEARER_TOKEN=
